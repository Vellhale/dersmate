# Frontend ortam değişkenleri. Bu dosyayı .env.development / .env.production olarak
# kopyalayıp doldurun (Vite yalnızca VITE_ önekli değişkenleri istemciye taşır).

VITE_API_URL=http://localhost:5000

# Google Analytics 4 ölçüm kimliği (Modül 4). BOŞ BIRAKILABİLİR:
# tanımlı değilse analitik kodu hiç yüklenmez ve tüm trackEvent çağrıları sessizce
# no-op olur — yerel geliştirmede ve testlerde istenen davranış budur.
# Doldurulsa bile script YALNIZCA kullanıcı analitik çerezlere izin verdiğinde yüklenir.
VITE_GA4_MEASUREMENT_ID=
