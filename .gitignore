appsettings.Development.json
appsettings.Local.json

# Playwright çıktıları (frontend/e2e). Rapor ve izler her koşuda yeniden üretilir;
# test-results/ içinde başarısız koşuların ekran görüntüleri de olur.
playwright-report/
test-results/
blob-report/
.playwright/

# --- Google Drive ---
# Drive her klasöre bir desktop.ini bırakıyor. Depoya girerse arkadaşının makinesinde
# anlamsız dosyalar olarak durur ve her senkronda gürültü diff'i üretir.
desktop.ini

# --- Playwright MCP oturum çıktıları ---
# Tarayıcı oturumlarının ekran görüntüleri ve konsol dökümleri (~2 MB, her koşuda yeniden
# üretilir). playwright-report/ zaten yukarıda; bu ayrı bir klasör.
.playwright-mcp/

# --- dotnet test ---
TestResults/

# --- ortam dosyaları ---
# .env.development ve .env.example DEPODA KALIR: içlerindeki her şey VITE_ önekli, yani
# tanım gereği istemciye gönderiliyor — gizli olamaz. Klonlayan kişi hiçbir şey
# kopyalamadan çalıştırabilsin diye bilinçli olarak izleniyorlar.
# Gerçek değer taşıyabilecek olanlar (üretim, kişisel geçersiz kılmalar) hariç:
.env.local
.env.*.local
.env.production

# --- editör / işletim sistemi ---
.idea/
Thumbs.db
.DS_Store
*.swp

# --- Claude Code kişisel ayarları ---
# Oto-commit hook'unu ETKİNLEŞTİREN dosya. Hangi hook'ların çalışacağı makineye
# özel bir tercih, ekip kuralı değil. Betiğin kendisi (.claude/hooks/oto-commit.sh)
# DEPODA KALIR: bu dosya olmadan kendiliğinden çalışmaz, yani klonlayan kimseyi
# sürprize uğratmaz — isteyen aynı hook'u kendi settings.local.json'ıyla açar.
.claude/settings.local.json

# --- önizleme çıktısı ---
# `npm run onizleme:tekdosya` üretiyor: derlenmiş arayüzün tamamını taşıyan ~430 KB'lık
# tek dosya HTML. Her koşuda yeniden üretiliyor, yani depoda tutulması gereken bir şey
# değil — girseydi her önizlemede tarihçeye yeni bir yarım megabaytlık blob eklenirdi.
# Kökteki dersmate-onizleme.html eski bir kopya ve HÂLÂ İZLENİYOR (kural yalnızca yeni
# yolu kapsıyor); onun temizliği ayrı bir karar.
frontend/dersmate-onizleme.html

# Redis anlık görüntüsü. docker-compose Redis kalıcılığını kapatıyor ama süreç
# elle çalıştırılırsa depo köküne dump.rdb yazıyor ve oto-commit hook u onu
# depoya alıyordu (claude/oturum-2026-08-25 dalında bir kez oldu).
dump.rdb

# --- ÜRETİM SIRLARI VE İŞLETİM DOSYALARI (2026-08-29) ---
# ⛔ İÇİNDE JWT ANAHTARI VE VERİTABANI PAROLASI VAR. Depoya girerse anahtarın
# gizliliği biter ve tarihçeden silmek zordur — bir kez itilmiş sır, sızmış sırdır.
# Üretmek için: tools/uretim-ayarlari-uret.ps1
.env.production
.env.production.*

# Sunucudaki işletim dosyaları: nginx yapılandırması (alan adlarıyla birlikte) ve
# Let's Encrypt sertifikaları + özel anahtarları. Şablonu tools/ornek-nginx.conf.
deploy/

# --- kökteki ekran görüntüleri ---
# Depo kökü, çalışırken alınan ekran görüntülerinin düştüğü yer. Oto-commit hook'u
# onları değişiklik sanıp commit'liyor: bir turda 4,7 MB'lık iki PNG bir PR'a karıştı.
#
# Kural YALNIZCA KÖKÜ kapsıyor (baştaki `/`). docs/ ya da frontend/ altındaki görseller
# etkilenmez — kasıtlı bir görsel zaten bir klasöre ait.
#
# Bugün izlenen 11 kök PNG'nin hiçbiri hiçbir yerden referans verilmiyor (ölçüldü);
# yani buraya düşen bir PNG bugüne kadar HER SEFERİNDE kazaydı. Zaten izlenenler bu
# kuraldan etkilenmiyor, temizlikleri ayrı bir karar.
/*.png
